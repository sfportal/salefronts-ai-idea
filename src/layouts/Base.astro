---
import '../styles/global.css';
interface Props { title?: string; description?: string; noSupport?: boolean }
const { title = 'Salefronts AI', description = 'Mô tả ý tưởng, AI chốt yêu cầu, nhận Media, Extension và Web làm trên mẫu có sẵn. Dành cho SME Việt Nam.', noSupport = false } = Astro.props;
const user = Astro.locals.user;
const ga = Astro.locals.settings?.ga4_id || '';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title === 'Salefronts AI' ? title : `${title} · Salefronts AI`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {ga && (
    <script is:inline define:vars={{ ga }}>
      window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} window.gtag = gtag;
      gtag('consent', 'default', { analytics_storage: localStorage.getItem('sf_consent') === 'yes' ? 'granted' : 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      gtag('js', new Date()); gtag('config', ga);
      const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga; document.head.appendChild(s);
    </script>
  )}
</head>
<body>
  <div class="aurora"><span></span><span></span><span></span></div>
  <canvas id="stars"></canvas>
  <header class="nav">
    <div class="wrap">
      <a class="logo" href="/"><i>✦</i> Salefronts<span class="grad">AI</span></a>
      <button class="burger" aria-label="Menu" onclick="this.nextElementSibling.classList.toggle('open')">☰</button>
      <nav>
        <a href="/#loai">Sản phẩm</a>
        <a href="/mau">Kho mẫu</a>
        <a href="/#quy-trinh">Quy trình</a>
        <a href="/dat-lich">Tư vấn 1:1</a>
        {user ? <a href="/tai-khoan">Tài khoản</a> : <a href="/dang-nhap">Đăng nhập</a>}
        {user && ['staff','admin','owner'].includes(user.role) && <a href="/admin">Quản trị</a>}
        <a class="btn sm" href="/bat-dau" data-ev="cta_nav">Bắt đầu yêu cầu</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site">
    <div class="wrap grid g4">
      <div><a class="logo" href="/"><i>✦</i> Salefronts AI</a><p style="margin-top:12px">Công ty Cổ phần Công nghệ Sáng tạo Salefronts<br/>MST 0318882755</p></div>
      <div><b>Sản phẩm</b><p><a href="/mau?kind=media">Media</a><br/><a href="/mau?kind=extension">Extension</a><br/><a href="/mau?kind=web">Web</a></p></div>
      <div><b>Hỗ trợ</b><p><a href="/dat-lich">Đặt lịch tư vấn</a><br/><a href="/chinh-sach">Chính sách & cookie</a><br/><a href="/tai-khoan/gioi-thieu">Giới thiệu bạn bè</a></p></div>
      <div><b>Liên hệ</b><p>Zalo 0938 266 958<br/>Số 1B, Đường 30, P. An Khánh, TP HCM</p></div>
    </div>
  </footer>

  <div class="cookie card" id="cookie">
    <b>Cookie và dữ liệu phiên</b>
    <p class="muted" style="font-size:14px;margin:6px 0 12px">Chúng tôi dùng cookie cần thiết để giữ đăng nhập và phiên yêu cầu của bạn, và cookie phân tích (Google Analytics) nếu bạn đồng ý. <a href="/chinh-sach#cookie">Chi tiết</a></p>
    <div style="display:flex;gap:8px"><button class="btn sm" id="ck-yes">Đồng ý tất cả</button><button class="btn sm ghost" id="ck-no">Chỉ cần thiết</button></div>
  </div>

  {!noSupport && (
    <>
      <button class="sbtn" id="sbtn" aria-label="Hỗ trợ">💬</button>
      <div class="spanel card" id="spanel">
        <header><span>Trợ lý Salefronts</span><button style="background:none;border:0;color:#fff;font-size:18px;cursor:pointer" id="sclose">✕</button></header>
        <div class="log" id="slog"><div class="msg assistant">Chào bạn! Mình có thể giúp gì về cách đặt làm sản phẩm, giá, thanh toán hay nhận kết quả?</div></div>
        <form id="sform"><input id="sinput" placeholder="Nhập câu hỏi..." autocomplete="off" /><button class="btn sm">Gửi</button></form>
      </div>
    </>
  )}

  <script>
    // star field
    const c = document.getElementById('stars') as HTMLCanvasElement; const x = c.getContext('2d')!;
    let W = 0, H = 0; const P: any[] = [];
    const size = () => { W = c.width = innerWidth * devicePixelRatio; H = c.height = innerHeight * devicePixelRatio; c.style.width = innerWidth + 'px'; c.style.height = innerHeight + 'px'; };
    size(); addEventListener('resize', size);
    for (let i = 0; i < 90; i++) P.push({ x: Math.random(), y: Math.random(), z: Math.random() * 0.8 + 0.2, v: Math.random() * 0.0004 + 0.0001 });
    let my = 0; addEventListener('mousemove', (e) => { my = (e.clientY / innerHeight - 0.5); });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    (function tick() {
      x.clearRect(0, 0, W, H);
      for (const p of P) { p.y -= p.v * p.z; if (p.y < 0) p.y = 1; x.globalAlpha = p.z * 0.8; x.fillStyle = '#fff'; x.beginPath(); x.arc(p.x * W, (p.y + my * 0.02 * p.z) * H, p.z * 1.4 * devicePixelRatio, 0, 7); x.fill(); }
      if (!reduce) requestAnimationFrame(tick);
    })();
    // reveal on scroll
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));
    // spotlight + tilt on cards
    document.querySelectorAll<HTMLElement>('.kind').forEach((el) => {
      el.addEventListener('mousemove', (e) => { const r = el.getBoundingClientRect(); const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
        el.style.setProperty('--mx', px * 100 + '%'); el.style.setProperty('--my', py * 100 + '%'); el.style.transform = `perspective(800px) rotateX(${(0.5 - py) * 6}deg) rotateY(${(px - 0.5) * 8}deg)`; });
      el.addEventListener('mouseleave', () => { el.style.transform = ''; });
    });
    // cookie consent
    const ck = document.getElementById('cookie')!;
    if (!localStorage.getItem('sf_consent')) ck.classList.add('show');
    const setC = (v: string) => { localStorage.setItem('sf_consent', v); ck.classList.remove('show'); (window as any).gtag?.('consent', 'update', { analytics_storage: v === 'yes' ? 'granted' : 'denied' }); fetch('/api/track', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type: 'consent', data: { v } }) }); };
    document.getElementById('ck-yes')!.onclick = () => setC('yes'); document.getElementById('ck-no')!.onclick = () => setC('no');
    // event tracking helper
    (window as any).sfTrack = (type: string, data?: any) => { (window as any).gtag?.('event', type, data || {}); fetch('/api/track', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type, data }) }).catch(() => {}); };
    document.querySelectorAll<HTMLElement>('[data-ev]').forEach((el) => el.addEventListener('click', () => (window as any).sfTrack(el.dataset.ev)));
    // support chatbot
    const sb = document.getElementById('sbtn'), sp = document.getElementById('spanel');
    if (sb && sp) {
      const log = document.getElementById('slog')!, inp = document.getElementById('sinput') as HTMLInputElement;
      const add = (role: string, t: string) => { const d = document.createElement('div'); d.className = 'msg ' + role; d.textContent = t; log.appendChild(d); log.scrollTop = 1e9; return d; };
      let loaded = false;
      sb.onclick = async () => { sp.classList.toggle('open'); if (!loaded && sp.classList.contains('open')) { loaded = true; try { const d = await (await fetch('/api/support')).json(); if (d.messages?.length) { log.querySelectorAll('.msg').forEach((m, i) => i > 0 && m.remove()); d.messages.forEach((m: any) => add(m.role, m.content)); } } catch {} } }; document.getElementById('sclose')!.onclick = () => sp.classList.remove('open');
      document.getElementById('sform')!.addEventListener('submit', async (e) => {
        e.preventDefault(); const t = inp.value.trim(); if (!t) return; inp.value = ''; add('user', t);
        const w = add('assistant', ''); w.innerHTML = '<span class="typing"><span></span><span></span><span></span></span>';
        try { const r = await fetch('/api/support', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text: t }) }); const d = await r.json(); w.textContent = d.reply || d.error; }
        catch { w.textContent = 'Mất kết nối, bạn thử lại nhé.'; }
      });
    }
  </script>
</body>
</html>
