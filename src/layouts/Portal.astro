---
import Base from './Base.astro';
interface Props { title: string; tab: string }
const { title, tab } = Astro.props; const u = Astro.locals.user;
const T = [['don', '/tai-khoan', 'Đơn của tôi'], ['tv', '/tai-khoan?tab=tv', 'Lịch tư vấn'], ['gd', '/tai-khoan?tab=gd', 'Giao dịch'], ['ls', '/tai-khoan?tab=ls', 'Lịch sử hoạt động'], ['vi', '/tai-khoan/vi', 'Ví'], ['studio', '/tai-khoan/studio', 'Studio tạo media'], ['gt', '/tai-khoan/gioi-thieu', 'Giới thiệu bạn bè']];
---
<Base title={title}>
  <section style="padding-top:44px"><div class="wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
      <div><span class="muted">Xin chào</span><h1 style="font-size:32px;margin:0">{u?.name || u?.email}</h1></div>
      <div style="display:flex;gap:8px"><a class="btn sm" href="/bat-dau">+ Yêu cầu mới</a><a class="btn sm ghost" href="/api/auth/logout">Đăng xuất</a></div>
    </div>
    <div class="tabs" style="margin-top:20px">{T.map(([k, h, l]) => <a href={h} class={tab === k ? 'on' : ''}>{l}</a>)}</div>
    <slot />
  </div></section>
</Base>
