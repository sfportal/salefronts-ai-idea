---
import Portal from '../../layouts/Portal.astro';
import { all } from '../../lib/db';
import { vnd } from '../../lib/util';
import { STATUS, KIND_LABEL } from '../../lib/orders';
const env = Astro.locals.runtime.env; const u = Astro.locals.user;
const tab = Astro.url.searchParams.get('tab') || 'don';
const orders = tab === 'don' ? await all<any>(env.DB, 'SELECT o.*, t.name tname FROM orders o JOIN templates t ON t.id=o.template_id WHERE o.user_id=? ORDER BY o.id DESC', u.id) : [];
const bookings = tab === 'tv' ? await all<any>(env.DB, 'SELECT * FROM bookings WHERE user_id=? OR lead_id IN (SELECT id FROM leads WHERE user_id=?) ORDER BY id DESC', u.id, u.id) : [];
const pays = tab === 'gd' ? await all<any>(env.DB, 'SELECT p.*, o.code ocode, b.code bcode FROM payments p LEFT JOIN orders o ON o.id=p.order_id LEFT JOIN bookings b ON b.id=p.booking_id WHERE p.user_id=? ORDER BY p.id DESC', u.id) : [];
const events = tab === 'ls' ? await all<any>(env.DB, 'SELECT * FROM events WHERE user_id=? ORDER BY id DESC LIMIT 100', u.id) : [];
const BK: any = { awaiting_payment: ['Chờ thanh toán', 'warn'], paid: ['Đã thanh toán, chờ xếp lịch', 'info'], scheduled: ['Đã xếp lịch', 'good'], done: ['Đã tư vấn', 'good'], cancelled: ['Đã huỷ', 'bad'] };
const EV: any = { login: 'Đăng nhập', sign_up: 'Tạo tài khoản', request_start: 'Tạo yêu cầu', mockup_view: 'Xem mockup', mockup_revise: 'Sửa mockup', checkout: 'Thanh toán', booking_create: 'Đặt lịch tư vấn', consent: 'Chọn cookie' };
---
<Portal title="Tài khoản" tab={tab}>
  {tab === 'don' && (orders.length ? (
    <div class="grid g2">{orders.map((o) => (
      <a class="card kind" href={`/tai-khoan/don/${o.code}`} style="text-decoration:none">
        <div style="display:flex;justify-content:space-between;gap:8px"><b>{o.code}</b><span class={`chip ${STATUS[o.status]?.tone}`}>{STATUS[o.status]?.label}</span></div>
        <h3 style="margin:10px 0 4px">{o.tname}</h3><div class="muted" style="font-size:14px">{KIND_LABEL[o.kind]} · tạo {o.created_at.slice(0, 10)}</div>
        <div style="margin-top:10px">{o.total ? <b>{vnd(o.total)}</b> : null} {o.paid_amount > 0 && o.paid_amount < o.total && <span class="chip warn">Còn {vnd(o.total - o.paid_amount)}</span>}</div>
      </a>))}</div>
  ) : <div class="card center"><p class="muted">Bạn chưa có yêu cầu nào.</p><a class="btn" href="/bat-dau">Bắt đầu yêu cầu đầu tiên</a></div>)}
  {tab === 'tv' && (<div class="card tbl"><table><tr><th>Mã</th><th>Mục tiêu</th><th>Ngân sách</th><th>Trạng thái</th><th>Lịch</th></tr>
    {bookings.map((b) => <tr><td>{b.code}</td><td>{b.goal}</td><td>{b.budget}</td><td><span class={`chip ${BK[b.status]?.[1]}`}>{BK[b.status]?.[0]}</span></td><td>{b.scheduled_at || '-'} {b.meet_url && <a href={b.meet_url} target="_blank">Vào phòng</a>}</td></tr>)}
    {!bookings.length && <tr><td colspan="5" class="muted">Chưa có lịch tư vấn. <a href="/dat-lich">Đặt lịch</a></td></tr>}</table></div>)}
  {tab === 'gd' && (<div class="card tbl"><table><tr><th>Mã GD</th><th>Cho</th><th>Số tiền</th><th>Loại</th><th>Trạng thái</th><th>Thời gian</th></tr>
    {pays.map((p) => <tr><td>{p.code}</td><td>{p.ocode || p.bcode}</td><td>{vnd(p.amount)}</td><td>{({ full: 'Toàn bộ', deposit: 'Cọc', balance: 'Còn lại', booking: 'Tư vấn' } as any)[p.kind]}</td><td><span class={`chip ${p.status === 'paid' ? 'good' : p.status === 'pending' ? 'warn' : 'bad'}`}>{({ paid: 'Đã thanh toán', pending: 'Chờ', cancelled: 'Huỷ', refunded: 'Đã hoàn' } as any)[p.status]}</span></td><td>{p.paid_at || p.created_at}</td></tr>)}
    {!pays.length && <tr><td colspan="6" class="muted">Chưa có giao dịch.</td></tr>}</table></div>)}
  {tab === 'ls' && (<div class="card tbl"><table><tr><th>Thời gian</th><th>Hoạt động</th><th>Chi tiết</th></tr>
    {events.map((e) => <tr><td>{e.created_at}</td><td>{EV[e.type] || e.type}</td><td class="muted" style="font-size:13px">{e.data}</td></tr>)}</table></div>)}
</Portal>
